global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "node"
    static_configs:
      - targets:
{% for h in groups['service'] + (groups['asg'] | default([])) %}
          - "{{ hostvars[h].ansible_host | default(h) }}:{{ node_exporter_port }}"
{% endfor %}

  - job_name: "app"
    metrics_path: /metrics
    static_configs:
      - targets:
{% for h in groups['service'] + (groups['asg'] | default([])) %}
          - "{{ hostvars[h].ansible_host | default(h) }}:{{ app_port }}"
{% endfor %}
